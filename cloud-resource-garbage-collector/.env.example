# Runtime
CRGC_DATABASE_URL=sqlite:///./garbage_collector.db
CRGC_LOG_LEVEL=INFO
CRGC_API_KEY=change-me
CRGC_ENABLE_DELETION=false
CRGC_APPROVAL_TTL_HOURS=72

# Scan defaults
CRGC_IDLE_DAYS=30
CRGC_OLD_SNAPSHOT_DAYS=90
CRGC_OLD_IMAGE_DAYS=90
CRGC_MIN_MONTHLY_COST=1.00

# AWS (prefer an IAM role or AWS SSO over static credentials)
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# Azure (DefaultAzureCredential is used)
AZURE_SUBSCRIPTION_IDS=

# GCP (Application Default Credentials are used)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

